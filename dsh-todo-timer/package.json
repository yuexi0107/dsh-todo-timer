{
  "name": "dsh-todo-timer",
  "version": "0.2.0",
  "description": "Live per-task timing for the DSH to-do panel: only in-progress items tick (parallel running tasks tick together), queued items show no clock, completed items freeze their measured run time, and the header shows the running total from the first task's start. A plugin — no patched install files.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-todo-timer.git"
  },
  "keywords": ["dsh", "dsh-plugin", "todo", "timer", "session-projection"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
